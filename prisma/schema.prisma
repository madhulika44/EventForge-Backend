generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(USER)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  events        Event[]
  venues        Venue[]
  bookings      Booking[]

  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Event {
  id            String      @id @default(uuid()) @db.Uuid
  organizerId   String      @db.Uuid
  title         String
  description   String?
  venueId       String?     @db.Uuid
  startDateTime DateTime
  endDateTime   DateTime
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Restrict (not Cascade): deleting an organizer's account should never
  // silently wipe out event records — those are business-critical once
  // bookings exist. User deletion isn't implemented yet, so this is
  // currently theoretical, but it's the safer default to start with.
  organizer User @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  // Same reasoning as organizer above: a Venue is a separate aggregate that
  // an Event merely references, so its deletion must never silently orphan
  // or null-out an event. The exposed DELETE /api/venues/:id is a soft
  // archive (see Venue.archivedAt) and never physically removes the row;
  // Restrict is defense-in-depth for any future/direct hard-delete path.
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // Composition, not reference — a ticket type has no meaning outside its
  // event (same reasoning as VenueSection -> Venue being Cascade rather
  // than Restrict).
  ticketTypes TicketType[]

  // Restrict: a booking is purchase history and must never be silently
  // destroyed by anything happening to its event.
  bookings Booking[]

  @@index([organizerId])
  @@index([status, startDateTime])
  @@index([venueId])
  @@map("events")
}

model Venue {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  name         String
  description  String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  capacity     Int
  // Soft-delete marker: DELETE /api/venues/:id sets this instead of removing
  // the row, mirroring how Event's own DELETE is a soft CANCELLED transition
  // rather than a physical delete. An archived venue is hidden from the
  // public list/detail but stays fully intact for any event referencing it,
  // and remains visible to its owner/ADMIN.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Restrict: see the matching comment on Event.organizer. Deleting a user
  // should never silently destroy the venues they created.
  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sections VenueSection[]
  events   Event[]

  @@index([ownerId])
  @@index([archivedAt, createdAt])
  @@map("venues")
}

model VenueSection {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @db.Uuid
  name        String
  description String?
  capacity    Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Cascade here (unlike the Restrict relations above) because a section has
  // no independent existence outside its venue — it's composition, not a
  // cross-aggregate reference. Deleting a venue's sections is only ever
  // reachable through our own hard-delete-free API today, but the schema
  // should still reflect that sections/seats belong to their venue.
  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats Seat[]

  // Restrict, not Cascade: unlike Seat (pure composition, no meaning outside
  // its section), a TicketType referencing this section is a real business
  // record that must not be silently orphaned or deleted just because the
  // venue's seating layout changes. This also means the existing hard-delete
  // section endpoint (built before TicketType existed) will now correctly
  // fail if a ticket type is linked to it — handled by the P2003 mapping
  // already added to error.middleware.ts in Phase 3.
  ticketTypes TicketType[]

  // Prevents two sections in the same venue from accidentally sharing a name
  // (e.g. two "VIP" sections created by mistake).
  @@unique([venueId, name])
  @@index([venueId])
  @@map("venue_sections")
}

model TicketType {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @db.Uuid
  name        String
  description String?

  // Exact decimal money storage (NUMERIC), not a float — see the Phase 4
  // report for why. Precision 10, scale 2: up to 99,999,999.99.
  price    Decimal @db.Decimal(10, 2)
  // ISO 4217 code (e.g. "INR", "USD"), validated at the Zod layer, not
  // hardcoded here — a new currency needs zero schema/migration changes.
  currency String

  // Total tickets available for sale. Deliberately just one number: no
  // soldQuantity/availableQuantity columns. Those would be counters the
  // future Booking phase would have to keep in sync by hand, which is
  // exactly the kind of redundant, driftable state this phase was told to
  // avoid — "sold" and "available" are derived from Booking rows later,
  // never stored here.
  quantity Int

  // Nullable: null = general admission (no seat-level assignment). When
  // set, the service layer enforces that the section belongs to this
  // event's venue and that quantity does not exceed the section's capacity
  // (a normal FK can't express either rule — see the Phase 4 report).
  venueSectionId String? @db.Uuid

  saleStartAt DateTime?
  saleEndAt   DateTime?

  status    TicketStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Cascade: a ticket type has no meaning outside its event, same
  // composition reasoning as VenueSection -> Venue.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Restrict: see the comment on VenueSection.ticketTypes above.
  venueSection VenueSection? @relation(fields: [venueSectionId], references: [id], onDelete: Restrict)

  // Restrict: a booking item is purchase history and must never be silently
  // destroyed by anything happening to the ticket type it references.
  bookingItems BookingItem[]

  // Prevents two same-named tiers on one event (e.g. two "VIP"s by mistake),
  // mirroring the VenueSection name-uniqueness precedent.
  @@unique([eventId, name])
  @@index([eventId, status])
  @@index([venueSectionId])
  @@map("ticket_types")
}

model Seat {
  id             String   @id @default(uuid()) @db.Uuid
  venueSectionId String   @db.Uuid
  rowLabel       String
  seatNumber     Int
  // Display label (e.g. "A1", or a custom name for an accessible seat that
  // doesn't fit the row/number pattern). Always populated: the service
  // defaults it to `${rowLabel}${seatNumber}` when a client doesn't supply one.
  label          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section VenueSection @relation(fields: [venueSectionId], references: [id], onDelete: Cascade)

  // Restrict: a booking item is purchase history and must never be silently
  // destroyed by anything happening to the seat it references. A seat can
  // still be referenced by many BookingItems over time (one per historical
  // booking) — what must never happen is two *active* bookings on it at
  // once, which is enforced by the partial unique index described on
  // BookingItem below, not by this relation.
  bookingItems BookingItem[]

  // A seat should not be duplicated within the same section.
  @@unique([venueSectionId, rowLabel, seatNumber])
  @@index([venueSectionId])
  @@map("seats")
}

model Booking {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // Denormalized on Booking (not on every BookingItem): a booking represents
  // exactly one event's purchase, and storing it once here — enforced by the
  // FK below plus a service-layer check that every item's ticket type
  // actually belongs to this event — makes that invariant explicit and makes
  // "list bookings for event X" a plain indexed query, without repeating
  // eventId on each line item where it would be pure redundancy (already
  // derivable via ticketType.eventId).
  eventId String @db.Uuid

  // Human-readable reference (e.g. "EVF-7K2M9XQP"), separate from the UUID
  // id, for support/lookup/display purposes.
  bookingReference String @unique

  status BookingStatus @default(PENDING)

  // Snapshotted once for the whole booking; the service rejects mixing
  // ticket types with different currencies in a single booking, since
  // summing across currencies without FX conversion is meaningless.
  currency String

  // Both persisted (not derived at read time): a booking's totals are a
  // historical financial fact that must stay stable even if pricing logic
  // changes later, exactly like BookingItem's price snapshot. total ==
  // subtotal today (no fees/taxes yet) — kept as two fields now rather than
  // one, matching the structure this phase was asked to consider, so that
  // adding fees/taxes later (total = subtotal + fees) needs no schema change
  // or backfill.
  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Only meaningful while status = PENDING; the hold window during which
  // this booking's inventory is considered reserved. Checked lazily (on
  // read, on cancel, and before a competing booking claims the same
  // inventory) rather than by a background job.
  expiresAt DateTime?

  // Optional client-supplied idempotency key, scoped per user: a repeated
  // (userId, idempotencyKey) pair returns the original booking instead of
  // creating a duplicate (protects against double-clicks/retries).
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a booking is purchase history and must never be silently
  // destroyed by anything happening to the user or event it references.
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  items    BookingItem[]
  payments Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([eventId])
  @@index([status, expiresAt])
  @@map("bookings")
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @db.Uuid

  // A plain String, not an enum — same reasoning as TicketType.currency:
  // adding Razorpay or another provider later needs zero schema/migration
  // changes. "stripe" for now.
  provider String

  // The provider's own id for this payment (Stripe PaymentIntent id,
  // "pi_..."). Always known before we persist the row — we call the
  // provider first, then save — so this is required, not nullable.
  providerPaymentId String

  // Snapshotted from Booking.total/currency at the moment this payment was
  // created — never recalculated from a possibly-changed booking later.
  // The webhook handler verifies an incoming event's amount/currency
  // against THIS, not against the (mutable) Booking, closing off any
  // possibility of a stale or tampered amount being accepted.
  amount   Decimal @db.Decimal(10, 2)
  currency String

  status PaymentStatus @default(PENDING)

  // The id of the last provider webhook event that changed this payment's
  // status. Recorded for audit/debugging traceability — NOT the primary
  // idempotency mechanism (that's the guarded conditional UPDATE described
  // in the Phase 6 report: `WHERE id = ? AND status = 'PENDING'`, which
  // Postgres's own row-level locking makes safe under concurrent/duplicate
  // webhook delivery on its own). Still kept unique as a DB-level sanity
  // check that two different payments never claim the same event.
  providerEventId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a payment is financial history and must never be silently
  // destroyed by anything happening to its booking.
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // A given provider's payment id must never be claimed by two different
  // Payment rows.
  @@unique([provider, providerPaymentId])
  @@index([bookingId, status])
  @@map("payments")
}

model BookingItem {
  id           String @id @default(uuid()) @db.Uuid
  bookingId    String @db.Uuid
  ticketTypeId String @db.Uuid

  // Null for General Admission; set for a specific physical seat. GA items
  // may have quantity > 1; a seat-linked item must have quantity == 1
  // (enforced by a CHECK constraint added via raw SQL in the migration,
  // since the Prisma schema DSL has no declarative CHECK syntax).
  seatId   String? @db.Uuid
  quantity Int

  // Immutable snapshots taken from TicketType.price/currency at the moment
  // of booking — see the Phase 5 report for why this must never be
  // recalculated from the current TicketType.price.
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  // Denormalized copy of the parent Booking's status, kept in sync in the
  // same transaction whenever the booking's status changes. Exists solely
  // so a partial unique index (added via raw SQL in the migration) can
  // enforce "this seat has at most one PENDING/CONFIRMED booking item" at
  // the database level — Postgres partial indexes can't reference a joined
  // table's column, so the status has to live on this row itself.
  status BookingStatus

  createdAt DateTime @default(now())

  // Cascade: a booking item has no meaning outside its booking (composition).
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Restrict: purchase history must never be silently destroyed by
  // something happening to the ticket type or seat it references.
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  seat       Seat?      @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([ticketTypeId, status])
  @@index([seatId])
  @@map("booking_items")
}
