# Server
NODE_ENV=development
PORT=4000

# Database (local PostgreSQL, database name "eventforge")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventforge?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Google OAuth (added when Google login is implemented)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Stripe (test mode). Leave both unset to use the built-in fake payment
# provider — the server and full test suite work with no Stripe account at
# all. Get real test-mode values from https://dashboard.stripe.com/test/apikeys
# and https://dashboard.stripe.com/test/webhooks (or the Stripe CLI) once you
# want to exercise real Stripe test-mode calls.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Redis, used only by the separate booking-expiry worker process (npm run worker)
REDIS_URL="redis://localhost:6379"
